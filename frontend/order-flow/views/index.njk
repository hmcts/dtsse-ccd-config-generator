{% extends "govuk/template.njk" %}
{% from "govuk/components/checkboxes/macro.njk" import govukCheckboxes %}
{% from "govuk/components/date-input/macro.njk" import govukDateInput %}

{% block pageTitle %}ProseMirror editor{% endblock %}

{% block head %}
  {% if not development %}
    <link rel="stylesheet" href="/assets/application.css">
  {% endif %}
{% endblock %}

{% block header %}{% endblock %}

{% block content %}
  <div class="govuk-grid-row">
    <div class="govuk-grid-column-full">
      <form id="order-form" novalidate>
        <section class="attendance" aria-labelledby="attendance-heading">
          <h1 class="govuk-heading-xl" id="attendance-heading">Attendance</h1>

          {% set parties = [
            { id: "claimant-1", kind: "claimant", number: 1, label: "Claimant 1: Mersey Community Housing", selected: "counsel" },
            { id: "defendant-1", kind: "defendant", number: 1, label: "Defendant 1: David Jones", selected: "solicitor" },
            { id: "defendant-2", kind: "defendant", number: 2, label: "Defendant 2: Fatima Taylor", selected: "solicitors-agent" }
          ] %}

          {% for party in parties %}
            <fieldset class="govuk-fieldset attendance-row"
                      data-attendance-row
                      data-party-kind="{{ party.kind }}"
                      data-party-number="{{ party.number }}">
              <legend class="govuk-visually-hidden">Attendance for {{ party.label }}</legend>
              <div class="attendance-party govuk-body govuk-!-font-weight-bold">{{ party.label }}</div>
              <div class="govuk-radios govuk-radios--inline govuk-radios--small attendance-options">
                {% set choices = [
                  { value: "counsel", label: "Csl" },
                  { value: "solicitor", label: "Sol" },
                  { value: "solicitors-agent", label: "S/A" },
                  { value: "housing-officer" if party.kind == "claimant" else "duty-adviser", label: "H/O" if party.kind == "claimant" else "Duty" },
                  { value: "in-person", label: "LiP" },
                  { value: "letter", label: "Ltr" },
                  { value: "not-present", label: "Not present" }
                ] %}
                {% for choice in choices %}
                  <div class="govuk-radios__item">
                    <input class="govuk-radios__input"
                           id="attendance-{{ party.id }}-{{ choice.value }}"
                           name="attendance-{{ party.id }}"
                           type="radio"
                           value="{{ choice.value }}"
                           {% if choice.value == party.selected %}checked{% endif %}>
                    <label class="govuk-label govuk-radios__label"
                           for="attendance-{{ party.id }}-{{ choice.value }}">{{ choice.label }}</label>
                  </div>
                {% endfor %}
              </div>
              <div class="attendance-name">
                <label class="govuk-label" for="attendance-{{ party.id }}-name">Name</label>
                <input class="govuk-input" id="attendance-{{ party.id }}-name" name="attendance-{{ party.id }}-name" type="text">
              </div>
            </fieldset>
          {% endfor %}
        </section>

        {{ govukDateInput({
          id: "order-date",
          namePrefix: "order-date",
          fieldset: {
            legend: {
              text: "Order date",
              classes: "govuk-fieldset__legend--m"
            }
          },
          hint: {
            text: "For example, 27 3 2007"
          }
        }) }}

        {{ govukCheckboxes({
          name: "structure-choice",
          classes: "structure-checkboxes",
          fieldset: {
            legend: {
              text: "Structure",
              classes: "govuk-fieldset__legend--m"
            }
          },
          items: [
            {
              value: "checked",
              text: "Check this box",
              checked: true
            },
            {
              value: "subpara-2",
              text: "Subpara 2"
            },
            {
              value: "subpara-3",
              text: "Subpara 3"
            }
          ]
        }) }}

        <div id="editor"></div>

        <section>
          <h2>Document structure</h2>
          <pre id="document-debug"></pre>
        </section>

        <section>
          <h2>Editor HTML</h2>
          <pre id="html-debug"></pre>
        </section>

        <section>
          <h2>Schema nodes</h2>
          <pre id="nodes-debug"></pre>
        </section>

        <section>
          <h2>Schema marks</h2>
          <pre id="marks-debug"></pre>
        </section>

        <section>
          <h2>Schema JSON</h2>
          <pre id="schema-debug"></pre>
        </section>
      </form>
    </div>
  </div>
{% endblock %}

{% block footer %}{% endblock %}

{% block bodyEnd %}
  {% if development %}
    <script type="module" src="/src/consumer.ts"></script>
  {% else %}
    <script type="module" src="/assets/application.js"></script>
  {% endif %}
{% endblock %}
